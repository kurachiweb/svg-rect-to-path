{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	// `*` also type-checks the config files in the project root (vite.config.ts etc.)
	"include": ["src", "*"],
	"exclude": ["src/service-worker"]
	// Path aliases are handled by https://svelte.dev/docs/kit/configuration#alias
	// and the `imports` field in package.json (e.g. `#lib`)
}
